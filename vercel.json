    {
      "source": "/comments/:path*/",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/post-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/category-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/author-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/gb_slider-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.*)"
        }
      ],
      "destination": "/blogs/?q=:q",
      "permanent": false
    },
    {
      "source": "/es",
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.*)"
        }
      ],
      "destination": "/es/blogs/?q=:q",
      "permanent": false
    },
    {
      "source": "/es/",
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.*)"
        }
      ],
      "destination": "/es/blogs/?q=:q",
      "permanent": false
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": true
    }
  ],
  "framework": null,
  "functions": {
    "api/survey-recommend.js": {
      "maxDuration": 20
    },
    "api/survey-lead.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/he/"
    },
    {
      "source": "/he",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/he/"
    },
    {
      "source": "/he/",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/he/"
    },
    {
      "source": "/he/:path*",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/he/:path*"
    },
    {
      "source": "/en",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/en/"
    },
    {
      "source": "/en/",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/en/"
    },
    {
      "source": "/en/:path*",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/en/:path*"
    },
    {
      "source": "/es",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/es/"
    },
    {
      "source": "/es/",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/es/"
    },
    {
      "source": "/es/:path*",
      "has": [{ "type": "host", "value": "survey.gobizit.ai" }],
      "destination": "/survey/es/:path*"
    },
    {
      "source": "/api/zoho-mail-webhook/",
      "destination": "/api/zoho-mail-webhook"
    },
    {
      "source": "/api/survey-recommend/",
      "destination": "/api/survey-recommend"
    },
    {
      "source": "/api/survey-lead/",
      "destination": "/api/survey-lead"
    }
  ],
  "headers": [
    {
      "source": "/wp-content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-includes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/survey/he/gift-ai-prompts-he.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gift-ai-prompts-he.pdf\""
        }
      ]
    },
    {
      "source": "/survey/he/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/survey/en/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/survey/es/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
